---
// The site is the console: `/play/` fills the window, and shows its own splash while it loads.
// The page's Built-in Synth (ADR 0087), which ships beside the console in `/play/`, plays it. The
// sound module takes the row below once it has controls.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Orcvs</title>
    <link rel="icon" href="/play/favicon.ico" />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #000000;
      }
      @media (prefers-color-scheme: light) {
        html,
        body {
          background: #ffffff;
        }
      }
      main {
        display: grid;
        grid-template-rows: 1fr;
        height: 100%;
      }
      iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <iframe src="/play/" title="Orcvs console"></iframe>
    </main>
    <script is:inline src="/play/synth-host.js"></script>
    <script>
      // The console is the page, so it has the keyboard from the start.
      const frame = document.querySelector("iframe")!;
      frame.addEventListener("load", () => frame.focus());
    </script>
  </body>
</html>
