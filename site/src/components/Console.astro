---
// The real console, embedded on demand: a still preview until the reader presses "Launch example".
// A console opened from a URL opens stopped and never reads or writes the reader's saved Source.
import { consoleFigure, type Embed } from "../console/embed";

type Props = Omit<Embed, "preview">;
---

<Fragment set:html={consoleFigure(Astro.props)} />

<script>
  import "../console/launch";
</script>
