---
// The real console, embedded on demand. The page shows a still preview until the reader presses
// "Launch example"; only then does it create a same-origin iframe of `/play/` at a URL naming the
// Source (`console/src/linked_source.rs`), so a page starts only the consoles its reader opens. A
// console opened from a URL opens stopped and never reads or writes the reader's saved Source.
interface Props {
  /** A shipped example's link name, such as `cell-tracker`. */
  example?: string;
  /** Source File text to open, `""` for an empty Source. */
  source?: string;
  /** What the preview says the console will open. */
  label?: string;
}

const { example, source, label } = Astro.props;
if ((example === undefined) === (source === undefined)) {
  throw new Error("<Console> takes exactly one of `example` or `source`");
}
const link =
  example !== undefined
    ? `/play/?example=${encodeURIComponent(example)}`
    : `/play/#source=${encodeURIComponent(source ?? "")}`;
const preview = source !== undefined ? source : null;
const name = label ?? (source === "" ? "An empty Source" : (example ?? "This Source"));
---

<figure class="orcvs-console not-content" data-link={link}>
  <div class="orcvs-console-preview">
    {preview !== null && preview !== "" && <pre>{preview}</pre>}
    <div class="orcvs-console-actions">
      <button type="button" class="orcvs-console-launch">Launch example</button>
      <a href={link} target="_blank" rel="noopener">Open full console</a>
    </div>
  </div>
  <p class="orcvs-console-failure" role="alert" hidden>
    The console could not start here. <a href={link} target="_blank" rel="noopener">Open it in its own tab</a>.
  </p>
  <figcaption>{name}</figcaption>
</figure>

<script>
  // How long a launched console has to draw before the lesson says it could not start.
  const START_TIMEOUT_MS = 20_000;

  // eframe sets the canvas's `width` attribute when it starts; a page whose WASM never ran keeps
  // the attribute-less 300 × 150 default.
  function started(frame: HTMLIFrameElement): boolean {
    return !!frame.contentDocument?.getElementById("the_canvas_id")?.hasAttribute("width");
  }

  for (const figure of document.querySelectorAll<HTMLElement>(".orcvs-console")) {
    const button = figure.querySelector<HTMLButtonElement>(".orcvs-console-launch");
    button?.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = figure.dataset.link!;
      frame.title = "Orcvs console";
      figure.querySelector(".orcvs-console-preview")!.replaceWith(frame);
      const failure = figure.querySelector<HTMLElement>(".orcvs-console-failure")!;
      const deadline = Date.now() + START_TIMEOUT_MS;
      // The frame does not take focus: keys stay with the page until the reader clicks it.
      const check = () => {
        if (started(frame)) return;
        if (Date.now() > deadline) {
          frame.remove();
          failure.hidden = false;
        } else {
          setTimeout(check, 250);
        }
      };
      check();
    });
  }
</script>

<style>
  .orcvs-console {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  /* The script creates the frame, so it carries no scoped-style attribute. */
  .orcvs-console :global(iframe) {
    display: block;
    width: 100%;
    height: 32rem;
    border: 0;
  }
  .orcvs-console-preview {
    padding: 1rem;
  }
  .orcvs-console-preview pre {
    margin: 0 0 0.75rem;
    font-family: var(--sl-font-mono);
  }
  .orcvs-console-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .orcvs-console-launch {
    font: inherit;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--sl-color-white);
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    cursor: pointer;
  }
  .orcvs-console-failure,
  .orcvs-console figcaption {
    padding: 0.5rem 1rem;
  }
  .orcvs-console figcaption {
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }
  /* A narrow screen gets the full console in its own tab rather than a cramped canvas. */
  @media (max-width: 50rem) {
    .orcvs-console-launch {
      display: none;
    }
  }
</style>
