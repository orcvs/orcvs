//
//  intrinsic vec atoms
//  cycle 1 2 3 4 •  */
//
//  play (A 1 1) (B 1 2)
//  p A

#[cfg(test)]
mod test {
    use crate::{parse_and_eval, parse_atom_list, Atom, Intrinsic};

    #[test]
    fn test_parse_and_eval() {
        parse_and_eval("take E 2").unwrap();
    }

    #[test]
    fn test_parse_atom_list() {
        let expected = vec![Atom::Num(1), Atom::Num(2)];
        let (_, output) = parse_atom_list("1 2").unwrap();
        assert_eq!(output, expected);

        let expected = vec![Atom::Hex('E')];
        let (_, output) = parse_atom_list("E").unwrap();
        assert_eq!(output, expected);

        let expected = vec![Atom::Hex('E'), Atom::Num(2)];
        let (_, output) = parse_atom_list("E 2").unwrap();
        assert_eq!(output, expected);

        let expected = vec![Atom::Hex('E'), Atom::Num(2)];
        let (_, output) = parse_atom_list("   E 2").unwrap();
        assert_eq!(output, expected);
    }
}
