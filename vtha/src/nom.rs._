// #![cfg(feature = "alloc")]

use std::error::Error;

use nom::{
    branch::alt,
    bytes::complete::tag,
    character::complete::{
        alpha1, char, digit1, hex_digit1, multispace0, multispace1, one_of, space0, space1,
    },
    combinator::{cut, map, map_res, opt},
    error::{context, VerboseError},
    multi::{many0, separated_list0},
    sequence::{delimited, preceded, terminated, tuple},
    IResult, Parser,
};

#[derive(Debug, PartialEq, Clone)]
pub enum Atom {
    Num(i32),
    Hex(char),
    Keyword(String),
    Boolean(bool),
}

#[derive(Debug, PartialEq, Clone)]
pub enum Note {
    A,
    As,
    B,
    Bs,
    C,
    Cs,
    D,
    Ds,
    E,
    F,
    Fs,
    G,
    Gs,
}
pub type List = Vec<Atom>;

#[derive(Debug, PartialEq, Clone)]
pub enum Intrinsic {
    Cycle(List),
    Play(Note, List),
    Take(List),
}

#[derive(Debug, PartialEq, Clone)]
pub enum Expression {}

pub fn parse_num<'a>(input: &'a str) -> IResult<&'a str, Atom, VerboseError<&'a str>> {
    alt((
        map_res(digit1, |digit_str: &str| {
            digit_str.parse::<i32>().map(Atom::Num)
        }),
        map(preceded(tag("-"), digit1), |digit_str: &str| {
            Atom::Num(-1 * digit_str.parse::<i32>().unwrap())
        }),
    ))(input)
}

pub fn parse_hex<'a>(input: &'a str) -> IResult<&'a str, Atom, VerboseError<&'a str>> {
    map(hex_digit1, |s: &str| {
        // let b: u8 = s.as_bytes()[0];
        let c: char = s.chars().next().unwrap();
        Atom::Hex(c)
    })(input)
}

pub fn parse_note<'a>(input: &'a str) -> IResult<&'a str, Note, VerboseError<&'a str>> {
    alt((
        map(tag("A"), |_| Note::A),
        map(tag("A#"), |_| Note::As),
        map(tag("B"), |_| Note::B),
        map(tag("C"), |_| Note::C),
        map(tag("C#"), |_| Note::Cs),
        map(tag("D"), |_| Note::D),
        map(tag("D#"), |_| Note::Ds),
        map(tag("E"), |_| Note::E),
        map(tag("F"), |_| Note::F),
        map(tag("F#"), |_| Note::Fs),
        map(tag("G"), |_| Note::G),
        map(tag("G#"), |_| Note::Gs),
    ))(input)
}

pub fn parse_play_parameters<'a>(
    input: &'a str,
) -> IResult<&'a str, (Note, List), VerboseError<&'a str>> {
    // preceded(terminated(tag("cycle"), space1), parse_atom_list),
    // preceded(multispace0, inner),
    tuple((parse_note, parse_atom_list))(input)
}

pub fn parse_atom<'a>(input: &'a str) -> IResult<&'a str, Atom, VerboseError<&'a str>> {
    alt((parse_num, parse_hex))(input)
}

pub fn parse_atom_list<'a>(input: &'a str) -> IResult<&'a str, List, VerboseError<&'a str>> {
    preceded(space0, separated_list0(space1, parse_atom))(input)
}

// pub fn parse_cycle<'a>(input: &'a str) -> IResult<&'a str, Intrinsic, VerboseError<&'a str>> {
//     let l = separated_list0(space1, parse_atom);
//     map(
//         preceded(terminated(tag("cycle"), space1), l),
//         |a: Vec<Atom>| Intrinsic::Cycle(a),
//     )(input)
// }

pub fn parse_intrinsic<'a>(input: &'a str) -> IResult<&'a str, Intrinsic, VerboseError<&'a str>> {
    alt((
        map(
            preceded(terminated(tag("cycle"), space1), parse_atom_list),
            |l: List| Intrinsic::Cycle(l),
        ),
        map(
            preceded(terminated(tag("play"), space1), parse_play_parameters),
            |(n, l)| Intrinsic::Play(n, l),
        ),
        map(
            preceded(terminated(tag("take"), space1), parse_atom_list),
            |l: List| Intrinsic::Take(l),
        ),
    ))(input)
}

fn eval(i: Intrinsic) -> Result<(), Box<dyn Error>> {
    match i {
        Intrinsic::Cycle(_) => {
            cycle()?;
        }
        Intrinsic::Play(note, list) => {
            play(note, list)?;
        }
        Intrinsic::Take(list) => {
            // take(list);
            println!("take");
            let el = list.first();
            println!("take {:?}", el);
        }
    }
    Ok(())
}

// pub fn take(list: List) -> Option<Atom> {
//     println!("take");
//     list.first()
// }

pub fn cycle() -> Result<(), Box<dyn Error>> {
    println!("cycle");
    Ok(())
}

pub fn play(note: Note, params: List) -> Result<(), Box<dyn Error>> {
    println!("play {:?} {:?}", note, params);
    Ok(())
}

pub fn parse_and_eval(input: &str) -> Result<(), Box<dyn Error>> {
    parse_intrinsic(input)
        .map_err(|e: nom::Err<VerboseError<&str>>| format!("{:#?}", e).into())
        .and_then(|(_, i)| eval(i))
}

