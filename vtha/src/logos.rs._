#[cfg(test)]
mod test {
    use crate::parse;

    // #[test]
    fn test_parse_value() {
        let src = "1 2 3 4 5";
        parse(src);

        let src = "A";
        parse(src);

        let src = "a";
        parse(src);

        let src = "F#";
        parse(src);
    }
}
