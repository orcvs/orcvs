target/
.mise.local.toml
**/.DS_Store
# The markdown issue tracker under .scratch/ is tracked; renders and generated
# data living alongside it are working files.
.scratch/**
!.scratch/**/
!.scratch/**/*.md
# Editable Theme examples are part of the format specification.
!.scratch/theming/examples/*.toml
!.scratch/theming/examples/*.json
!.scratch/theming/examples/*.yaml
!.scratch/theming/examples/*.yml
# Release evidence captures are delivered artefacts, not working files.
!.scratch/*/evidence/*.png
# The theme workbench is a working tool kept with the theming notes; its builds are not.
!.scratch/theming/workbench/**
.scratch/theming/workbench/specimen-dump/target/
.scratch/theming/workbench/specimen-dump/rust-toolchain.toml
.claude/worktrees/
.worktrees/
# Codex project config is tracked; local worktrees and other Codex working
# files are not.
.codex/*
!.codex/config.toml
# Cursor keeps per-session debug logs here; none of it is repository state.
.cursor/
