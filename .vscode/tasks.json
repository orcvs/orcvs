{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "cargo nextest run --no-capture",
			"group": "build",
			"label": "cargo nextest run"
		},
		{
			"type": "cargo",
			"command": "run",
			"problemMatcher": [
				"$rustc"
			],
			"label": "cargo run"
		},
		{
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"label": "cargo build"
		}
	]
}